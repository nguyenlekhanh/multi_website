# =============================================================================
# MultiSite Platform — environment configuration
#
# NEVER commit real credentials. Local development uses this file (gitignored);
# Vercel deployments configure the same variables in the dashboard, separated
# into Preview and Production environments (see README "Deploy to Vercel").
# =============================================================================

# --- Data source selection (REQUIRED in production) --------------------------
# seed     typed demo fixtures (development/demo only)
# postgres real PostgreSQL via the Prisma-backed adapter (production)
#
# Production builds and runtime REFUSE to start without an explicit value —
# the build intentionally fails with an actionable error if this is missing
# (verified). In development an unset DATA_SOURCE defaults to seed.
DATA_SOURCE=seed

# --- PostgreSQL (required when DATA_SOURCE=postgres) -------------------------
# Supabase: use the POOLED connection string (port 6543, pgbouncer=true) for
# application queries, and the DIRECT one (port 5432) as DIRECT_URL for
# migrations. Example shapes (placeholders only):
#
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.supabase.com:5432/postgres"
#
# Local development example (this machine's throwaway instance):
DATABASE_URL="postgresql://mspp_admin@127.0.0.1:5544/mspp_test"

# --- Auth.js (REQUIRED in production) ----------------------------------------
# Session signing secret. Generate with:  openssl rand -base64 32
AUTH_SECRET="generate-and-set-a-long-random-secret"

# --- Admin provisioning (CLI only, never used by the app) --------------------
# ADMIN_PROVISION_PASSWORD is read by `npm run admin:provision` (the password
# is never accepted as a CLI argument and never logged). The script refuses to
# run under NODE_ENV=production unless ALLOW_ADMIN_PROVISION_IN_PROD=1 is set.
# ADMIN_PROVISION_PASSWORD="..."

# --- SEO (optional) ----------------------------------------------------------
# Canonical origin used for metadata in production. When unset, the origin is
# derived from request headers (correct per-site on multi-domain deployments).
# NEXT_PUBLIC_SITE_URL="https://your-primary-domain.example"

# --- Stripe (FUTURE / NOT IMPLEMENTED) ---------------------------------------
# Billing is NOT part of the platform yet — do not set these until a billing
# phase ships real code that reads them. Placeholders documented for later:
# STRIPE_SECRET_KEY="sk_test_..."        # server-only, never NEXT_PUBLIC_*
# STRIPE_WEBHOOK_SECRET="whsec_..."      # server-only
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."  # safe for the browser

# --- AI content automation (optional; websites work without it) --------------
# Provider selection happens per site in the admin UI; these variables
# configure which providers the SERVER can reach. Keys are server-only and
# never returned to the browser.
# Local Ollama (loopback allowed only for this provider):
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5vl:3b"
# OpenAI (leave unset to disable):
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"   # optional override
# Any OpenAI-compatible endpoint:
# OPENAI_COMPAT_BASE_URL="https://api.mistral.ai/v1"
# OPENAI_COMPAT_API_KEY="..."
# Worker tuning (npm run ai:worker):
# AI_WORKER_POLL_INTERVAL_MS=15000
# AI_WORKER_CONCURRENCY=1
# AI_GENERATION_TIMEOUT_MS=120000
# Vercel Cron sweep endpoint (/api/ai/cron) — required only if you use cron:
# CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- Test-only (never production) --------------------------------------------
# Enables PostgreSQL integration tests (npm test). Must be a DISPOSABLE
# database — the integration suites wipe and reseed it.
# TEST_DATABASE_URL="postgresql://user:password@host:5432/platform_test"
