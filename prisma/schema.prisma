// MultiSite Platform — database schema (source of truth).
//
// docs/schema.sql is kept as a readable reference; this file generates the
// version-controlled migrations in prisma/migrations/. Apply with
// `npm run db:deploy` (production) or `npm run db:migrate` (development).
//
// Delete behavior: content rows RESTRICT the deletion of their Site so a
// website's data can never disappear by accident; removing a site is an
// explicit, ordered operation (delete content first). SiteSettings is a pure
// child record and cascades.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum AdminRole {
  SUPER_ADMIN
  SITE_ADMIN
}

enum AiJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiPublishMode {
  DRAFT
  SCHEDULED
  AUTOPILOT
}

model Site {
  id        String     @id
  name      String
  themeId   String     @map("theme_id")
  status    SiteStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  settings   SiteSettings?
  domains    Domain[]
  pages      Page[]
  posts      Post[]
  categories Category[]
  authors    Author[]
  media      Media[]
  memberships SiteMembership[]
  aiSettings  AiSettings?
  aiTopics    AiTopic[]
  aiJobs      AiJob[]

  @@map("sites")
}

model Domain {
  id        Int     @id @default(autoincrement())
  siteId    String  @map("site_id")
  host      String  @unique
  isPrimary Boolean @default(false) @map("is_primary")
  verified  Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@map("domains")
}

model SiteSettings {
  siteId    String   @id @map("site_id")
  /// { name, tagline, logoText, logoInitials } — validated on read/write
  identity  Json
  /// BrandColors — validated
  colors    Json
  /// NavItem[] — validated
  nav       Json
  /// NavItem[] — validated
  footerNav Json     @map("footer_nav")
  /// SeoSettings — validated
  seo       Json
  /// Forward-compatible bag (e.g. landingBlurb) — not read by core logic
  extras    Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_settings")
}

model Page {
  id             Int          @id @default(autoincrement())
  siteId         String       @map("site_id")
  slug           String
  title          String
  eyebrow        String?
  seoTitle       String?      @map("seo_title")
  seoDescription String?      @map("seo_description")
  ogImage        String?      @map("og_image")
  isHomepage     Boolean      @default(false) @map("is_homepage")
  status         ContentStatus @default(PUBLISHED)
  /// Block[] — validated against the platform Block union
  blocks         Json         @default("[]")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // A slug exists at most once per site; drafts flip status in place.
  @@unique([siteId, slug])
  @@index([siteId, status])
  @@map("pages")
}

model Category {
  id          String  @id
  siteId      String  @map("site_id")
  slug        String
  name        String
  description String?

  site  Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  posts Post[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@map("categories")
}

model Author {
  id       String  @id
  siteId   String  @map("site_id")
  slug     String
  name     String
  role     String?
  bio      String?
  initials String
  avatar   String?

  site  Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  posts Post[]
  aiSettings AiSettings[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@map("authors")
}

model Post {
  id             Int           @id @default(autoincrement())
  siteId         String        @map("site_id")
  slug           String
  title          String
  excerpt        String        @default("")
  /// string[] of paragraphs — validated
  body           Json          @default("[]")
  coverImage     String?       @map("cover_image")
  coverAlt       String?       @map("cover_alt")
  categoryId     String?       @map("category_id")
  authorId       String        @map("author_id")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  status         ContentStatus @default(PUBLISHED)
  featured       Boolean       @default(false)
  readingMinutes Int           @default(5) @map("reading_minutes")
  tags           String[]
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   Author    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([siteId, slug])
  @@index([siteId, status, publishedAt(sort: Desc)])
  @@index([siteId, categoryId])
  @@map("posts")
}

model Media {
  id        Int      @id @default(autoincrement())
  siteId    String   @map("site_id")
  /// Storage path or CDN URL — binaries are never stored in the row
  src       String
  alt       String   @default("")
  kind      String   @default("image")
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([siteId, src])
  @@index([siteId])
  @@map("media")
}

// ============================================================================
// Administration: accounts, per-site grants, and the audit trail.
// ============================================================================

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  /// bcrypt hash — plaintext passwords are never stored or logged
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(SITE_ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships SiteMembership[]
  auditLogs   AuditLog[]

  @@map("admin_users")
}

/// Explicit grants: a SITE_ADMIN may manage exactly these sites.
/// SUPER_ADMINs ignore this table (implicit access to everything).
model SiteMembership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
  @@map("site_memberships")
}

// ============================================================================
// AI content automation: per-site configuration, topic queue, job records.
// ============================================================================

/// Per-site automation configuration (1:1). Provider API keys are NEVER
/// stored here — they come from server-side environment variables only.
model AiSettings {
  siteId    String  @id @map("site_id")
  enabled   Boolean @default(false)
  /// "ollama" | "openai" | "openai-compatible"
  provider  String  @default("ollama")
  /// Model identifier within the selected provider (e.g. "qwen2.5vl:3b").
  model     String  @default("")
  language  String  @default("English")
  tone      String  @default("professional")
  audience  String  @default("")
  /// Target body length in words; enforced with bounds at generation time.
  wordCountTarget Int    @default(800) @map("word_count_target")
  /// "article" | "listicle" | "howto"
  format    String  @default("article")
  /// Author + allowed categories must belong to this site (validated).
  authorId  String? @map("author_id")
  categoryIds String[] @map("category_ids")
  /// DRAFT | SCHEDULED | AUTOPILOT
  publishMode AiPublishMode @default(DRAFT) @map("publish_mode")
  postsPerWeek Int @default(3) @map("posts_per_week")
  /// Preferred local publish times, "HH:mm" strings.
  publishTimes String[] @map("publish_times")
  /// IANA time zone for publish times and daily limits.
  timezone  String  @default("UTC")
  maxAttempts Int @default(3) @map("max_attempts")
  maxArticlesPerDay Int @default(2) @map("max_articles_per_day")
  /// Optional extra writing instructions from the administrator.
  customInstructions String? @map("custom_instructions")
  lastGenerationAt DateTime? @map("last_generation_at")
  /// Global pause switch for this site's automation.
  paused    Boolean @default(false)
  /// Local date (yyyy-mm-dd in the site timezone) of the last scheduling sweep.
  lastScheduleDate String? @map("last_schedule_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("ai_settings")
}

/// Topic definitions the generator draws from. Per-site scoped.
model AiTopic {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  title     String
  keywords  String[]
  /// Topics/angles the model must avoid.
  excluded  String[]
  notes     String?
  active    Boolean  @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  usageCount Int @default(0) @map("usage_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  jobs AiJob[]

  @@unique([siteId, title])
  @@index([siteId, active])
  @@map("ai_topics")
}

/// Generation/publishing job records — the persistent queue.
model AiJob {
  id        String      @id @default(cuid())
  siteId    String      @map("site_id")
  topicId   String?     @map("topic_id")
  /// Human-readable topic snapshot (survives topic deletion).
  topicTitle String     @map("topic_title")
  type      String      @default("GENERATE_ARTICLE")
  status    AiJobStatus @default(PENDING)
  attempts  Int         @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  scheduledAt DateTime   @default(now()) @map("scheduled_at")
  startedAt DateTime?   @map("started_at")
  finishedAt DateTime?  @map("finished_at")
  /// Sanitized, user-safe error message (no provider internals).
  error     String?
  /// The created post (posts.id) once generation succeeded.
  postId    Int?        @map("post_id")
  /// Which worker claimed the job (diagnostics only).
  workerId  String?     @map("worker_id")
  /// Uniqueness guarantee: one enqueue per site/topic/day-slot.
  idempotencyKey String @unique @map("idempotency_key")
  /// Provider, model, publish mode, publishAt, prompt version. No secrets.
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  site  Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topic AiTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([siteId, status])
  @@map("ai_jobs")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  /// SetNull: the log survives account deletion.
  actorId      String?  @map("actor_id")
  /// Denormalized snapshot so the trail stays readable after user deletion.
  actorEmail   String   @map("actor_email")
  action       String
  /// Plain text, no FK: audit entries outlive deleted sites.
  targetSiteId String?  @map("target_site_id")
  summary      String
  /// Optional structured details (never secrets).
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetSiteId])
  @@index([actorId])
  @@map("audit_logs")
}
